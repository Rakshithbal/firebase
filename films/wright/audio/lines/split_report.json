[
 {
  "id": 1,
  "take": "T01_cold_open",
  "start": 0.0,
  "end": 4.599,
  "speech_s": 3.77,
  "letters": 60,
  "lps": 15.91,
  "text": "December 17th, 1903. A windy beach in North Carolina.",
  "flag": false
 },
 {
  "id": 2,
  "take": "T01_cold_open",
  "start": 4.599,
  "end": 7.744,
  "speech_s": 2.47,
  "letters": 37,
  "lps": 14.99,
  "text": "A machine of spruce and cloth leaves the sand.",
  "flag": false
 },
 {
  "id": 3,
  "take": "T01_cold_open",
  "start": 7.744,
  "end": 11.464,
  "speech_s": 2.71,
  "letters": 36,
  "lps": 13.28,
  "text": "Twelve seconds. One hundred and twenty feet.",
  "flag": false
 },
 {
  "id": 4,
  "take": "T01_cold_open",
  "start": 11.464,
  "end": 17.143,
  "speech_s": 4.96,
  "letters": 72,
  "lps": 14.52,
  "text": "A man from the life-saving station took the photograph. He had never used a camera before.",
  "flag": false
 },
 {
  "id": 5,
  "take": "T02_dayton",
  "start": 0.0,
  "end": 4.367,
  "speech_s": 3.66,
  "letters": 54,
  "lps": 14.77,
  "text": "Four years earlier, two brothers ran a bicycle shop in Dayton, Ohio.",
  "flag": false
 },
 {
  "id": 6,
  "take": "T02_dayton",
  "start": 4.367,
  "end": 8.395,
  "speech_s": 3.01,
  "letters": 50,
  "lps": 16.63,
  "text": "Wilbur and Orville Wright. Neither had a high school diploma.",
  "flag": false
 },
 {
  "id": 7,
  "take": "T02_dayton",
  "start": 8.395,
  "end": 13.748,
  "speech_s": 4.5,
  "letters": 73,
  "lps": 16.21,
  "text": "In 1899, Wilbur wrote to the Smithsonian for everything it had on flight.",
  "flag": false
 },
 {
  "id": 8,
  "take": "T02_dayton",
  "start": 13.748,
  "end": 16.962,
  "speech_s": 2.48,
  "letters": 34,
  "lps": 13.71,
  "text": "I am an enthusiast, he wrote, but not a crank.",
  "flag": false
 },
 {
  "id": 9,
  "take": "T03_the_rival",
  "start": 0.0,
  "end": 4.981,
  "speech_s": 4.3,
  "letters": 65,
  "lps": 15.1,
  "text": "The man in charge there, Samuel Langley, was building a flying machine of his own.",
  "flag": false
 },
 {
  "id": 10,
  "take": "T03_the_rival",
  "start": 4.981,
  "end": 8.475,
  "speech_s": 2.84,
  "letters": 43,
  "lps": 15.14,
  "text": "The War Department gave him fifty thousand dollars.",
  "flag": false
 },
 {
  "id": 11,
  "take": "T03_the_rival",
  "start": 8.475,
  "end": 15.754,
  "speech_s": 6.05,
  "letters": 97,
  "lps": 16.03,
  "text": "On October 7th, 1903, it launched from a houseboat on the Potomac, and dropped straight into the river.",
  "flag": false
 },
 {
  "id": 12,
  "take": "T03_the_rival",
  "start": 15.754,
  "end": 22.037,
  "speech_s": 5.39,
  "letters": 78,
  "lps": 14.48,
  "text": "Two days later, The New York Times said a real flying machine might take one to ten million years.",
  "flag": false
 },
 {
  "id": 13,
  "take": "T03_the_rival",
  "start": 22.037,
  "end": 26.931,
  "speech_s": 3.66,
  "letters": 52,
  "lps": 14.2,
  "text": "On December 8th, Langley tried again. Same river. Same result.",
  "flag": false
 },
 {
  "id": 14,
  "take": "T04_kitty_hawk",
  "start": 0.0,
  "end": 3.491,
  "speech_s": 2.98,
  "letters": 49,
  "lps": 16.45,
  "text": "Nine days later, the Wright brothers were back on that beach.",
  "flag": false
 },
 {
  "id": 15,
  "take": "T04_kitty_hawk",
  "start": 3.491,
  "end": 6.839,
  "speech_s": 2.69,
  "letters": 47,
  "lps": 17.45,
  "text": "Their whole effort had cost less than a thousand dollars.",
  "flag": false
 },
 {
  "id": 16,
  "take": "T04_kitty_hawk",
  "start": 6.839,
  "end": 12.062,
  "speech_s": 3.99,
  "letters": 55,
  "lps": 13.8,
  "text": "Orville flew first. By noon, Wilbur stayed up for fifty-nine seconds.",
  "flag": false
 },
 {
  "id": 17,
  "take": "T04_kitty_hawk",
  "start": 12.062,
  "end": 17.129,
  "speech_s": 3.59,
  "letters": 54,
  "lps": 15.02,
  "text": "They wired their father: Success. Four flights. Home for Christmas.",
  "flag": false
 },
 {
  "id": 18,
  "take": "T05_close",
  "start": 0.0,
  "end": 4.102,
  "speech_s": 3.58,
  "letters": 58,
  "lps": 16.18,
  "text": "The government spent fifty thousand dollars, and got a wreck in a river.",
  "flag": false
 },
 {
  "id": 19,
  "take": "T05_close",
  "start": 4.102,
  "end": 8.288,
  "speech_s": 3.62,
  "letters": 53,
  "lps": 14.65,
  "text": "Two bicycle mechanics spent less than a thousand, and got the sky.",
  "flag": false
 }
]