[
 {
  "id": 1,
  "take": "T01_cold_open",
  "start": 0.0,
  "end": 5.2,
  "speech_s": 4.2,
  "letters": 60,
  "lps": 14.29,
  "text": "December 17th, 1903. A windy beach in North Carolina.",
  "flag": false
 },
 {
  "id": 2,
  "take": "T01_cold_open",
  "start": 5.2,
  "end": 8.698,
  "speech_s": 2.57,
  "letters": 37,
  "lps": 14.37,
  "text": "A machine of spruce and cloth leaves the sand.",
  "flag": false
 },
 {
  "id": 3,
  "take": "T01_cold_open",
  "start": 8.698,
  "end": 12.323,
  "speech_s": 2.35,
  "letters": 36,
  "lps": 15.34,
  "text": "Twelve seconds. One hundred and twenty feet.",
  "flag": false
 },
 {
  "id": 4,
  "take": "T01_cold_open",
  "start": 12.323,
  "end": 18.57,
  "speech_s": 5.24,
  "letters": 72,
  "lps": 13.75,
  "text": "A man from the life-saving station took the photograph. He had never used a camera before.",
  "flag": false
 },
 {
  "id": 5,
  "take": "T02_dayton",
  "start": 0.0,
  "end": 5.205,
  "speech_s": 4.29,
  "letters": 54,
  "lps": 12.6,
  "text": "Four years earlier, two brothers ran a bicycle shop in Dayton, Ohio.",
  "flag": false
 },
 {
  "id": 6,
  "take": "T02_dayton",
  "start": 5.205,
  "end": 9.808,
  "speech_s": 3.25,
  "letters": 50,
  "lps": 15.4,
  "text": "Wilbur and Orville Wright. Neither had a high school diploma.",
  "flag": false
 },
 {
  "id": 7,
  "take": "T02_dayton",
  "start": 9.808,
  "end": 15.94,
  "speech_s": 4.63,
  "letters": 73,
  "lps": 15.75,
  "text": "In 1899, Wilbur wrote to the Smithsonian for everything it had on flight.",
  "flag": false
 },
 {
  "id": 8,
  "take": "T02_dayton",
  "start": 15.94,
  "end": 19.181,
  "speech_s": 2.4,
  "letters": 34,
  "lps": 14.17,
  "text": "I am an enthusiast, he wrote, but not a crank.",
  "flag": false
 },
 {
  "id": 9,
  "take": "T03_the_rival",
  "start": 0.0,
  "end": 5.598,
  "speech_s": 4.46,
  "letters": 65,
  "lps": 14.56,
  "text": "The man in charge there, Samuel Langley, was building a flying machine of his own.",
  "flag": false
 },
 {
  "id": 10,
  "take": "T03_the_rival",
  "start": 5.598,
  "end": 9.442,
  "speech_s": 2.85,
  "letters": 43,
  "lps": 15.09,
  "text": "The War Department gave him fifty thousand dollars.",
  "flag": false
 },
 {
  "id": 11,
  "take": "T03_the_rival",
  "start": 9.442,
  "end": 17.649,
  "speech_s": 6.25,
  "letters": 97,
  "lps": 15.52,
  "text": "On October 7th, 1903, it launched from a houseboat on the Potomac, and dropped straight into the river.",
  "flag": false
 },
 {
  "id": 12,
  "take": "T03_the_rival",
  "start": 17.649,
  "end": 24.893,
  "speech_s": 5.71,
  "letters": 78,
  "lps": 13.67,
  "text": "Two days later, The New York Times said a real flying machine might take one to ten million years.",
  "flag": false
 },
 {
  "id": 13,
  "take": "T03_the_rival",
  "start": 24.893,
  "end": 29.539,
  "speech_s": 3.83,
  "letters": 52,
  "lps": 13.58,
  "text": "On December 8th, Langley tried again. Same river. Same result.",
  "flag": false
 },
 {
  "id": 14,
  "take": "T04_kitty_hawk",
  "start": 0.0,
  "end": 3.927,
  "speech_s": 3.12,
  "letters": 49,
  "lps": 15.69,
  "text": "Nine days later, the Wright brothers were back on that beach.",
  "flag": false
 },
 {
  "id": 15,
  "take": "T04_kitty_hawk",
  "start": 3.927,
  "end": 7.904,
  "speech_s": 3.05,
  "letters": 47,
  "lps": 15.42,
  "text": "Their whole effort had cost less than a thousand dollars.",
  "flag": false
 },
 {
  "id": 16,
  "take": "T04_kitty_hawk",
  "start": 7.904,
  "end": 13.33,
  "speech_s": 4.05,
  "letters": 55,
  "lps": 13.59,
  "text": "Orville flew first. By noon, Wilbur stayed up for fifty-nine seconds.",
  "flag": false
 },
 {
  "id": 17,
  "take": "T04_kitty_hawk",
  "start": 13.33,
  "end": 17.909,
  "speech_s": 3.7,
  "letters": 54,
  "lps": 14.59,
  "text": "They wired their father: Success. Four flights. Home for Christmas.",
  "flag": false
 },
 {
  "id": 18,
  "take": "T05_close",
  "start": 0.0,
  "end": 4.424,
  "speech_s": 3.63,
  "letters": 58,
  "lps": 15.98,
  "text": "The government spent fifty thousand dollars, and got a wreck in a river.",
  "flag": false
 },
 {
  "id": 19,
  "take": "T05_close",
  "start": 4.424,
  "end": 9.07,
  "speech_s": 3.84,
  "letters": 53,
  "lps": 13.81,
  "text": "Two bicycle mechanics spent less than a thousand, and got the sky.",
  "flag": false
 }
]